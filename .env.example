# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL credentials (interpolated into config/application-prod.yaml)
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fraud_db

# OpenAI API key (only required when llm.provider is switched to openai)
OPENAI_API_KEY=

# Origins allowed to call the RAG API (comma-separated). Must include the
# dashboard's origin, e.g. http://localhost:8080 for the dockerized frontend.
CORS_ORIGINS=http://localhost:8080

# Build-time config baked into the React dashboard (see frontend/.env.example)
VITE_API_BASE_URL=http://localhost:8002
VITE_INJECT_URL=
